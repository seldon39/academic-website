<!DOCTYPE html>
<html lang="{{ lang or 'en' }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="google-site-verification" content="zynSqpGiXhh0hxyMgPxqkuckaRrMupw3AnHVsFhe1oA" />
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#1e293b" media="(prefers-color-scheme: dark)" />

  <title>{% if title %}{{ title }} | {% endif %}Razvan Apredoaei</title>
  <meta name="description" content="{{ description or site.description or 'Page personnelle et travaux de recherche de Razvan Apredoaei, chercheur en mathématiques.' }}">
  <meta name="author" content="Razvan Apredoaei">
  <meta name="robots" content="index, follow">

  {% if site.url %}
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {% endif %}

  <meta property="og:type" content="website">
  <meta property="og:title" content="{% if title %}{{ title }} | {% endif %}Razvan Apredoaei">
  <meta property="og:description" content="{{ description or site.description or 'Page personnelle et travaux de recherche de Razvan Apredoaei.' }}">
  {% if site.url %}
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  {% endif %}
  <meta property="og:site_name" content="Razvan Apredoaei">

  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{% if title %}{{ title }} | {% endif %}Razvan Apredoaei">
  <meta name="twitter:description" content="{{ description or site.description or 'Page personnelle et travaux de recherche de Razvan Apredoaei.' }}">

  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>

  <!-- CSS principal (bloquant : evite le FOUC) -->
  <link rel="stylesheet" href="/assets/style.css">

  <!-- Font Awesome : CSS + preload des 2 seules polices reellement utilisees.
       Le preload garantit que les glyphes du footer sont prets AVANT d'y arriver,
       donc aucun reflow tardif quand les icones entrent dans le viewport. -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="preload" as="font" type="font/woff2" crossorigin
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-solid-900.woff2">
  <link rel="preload" as="font" type="font/woff2" crossorigin
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-brands-400.woff2">

  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js" defer></script>

  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
  <link rel="shortcut icon" href="/assets/favicon.ico" />
  <link rel="icon" type="image/x-icon" href="/assets/favicon.ico" />
  <link rel="icon" type="image/png" sizes="96x96" href="/assets/favicon-96x96.png" />
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <meta name="apple-mobile-web-app-title" content="Razvan Apredoaei" />
  <link rel="manifest" href="/assets/site.webmanifest" />
</head>

<body>
  <header>
    <div class="container header-content">
      <div class="header-top">
        <h2 class="site-header-title">
          <a href="{% if lang == 'fr' %}/fr/{% else %}/{% endif %}" class="site-title">
            <!-- Logo : deux variantes servies selon le mode. Aucun filter, aucun
                 mask -> le carre blanc est structurellement impossible. -->
            <picture class="site-logo">
              <source srcset="/assets/logo-dark.png" media="(prefers-color-scheme: dark)" type="image/png">
              <img src="/assets/logo-light.png" alt="" width="28" height="28" decoding="async">
            </picture>
            <span>Razvan Apredoaei</span>
          </a>
        </h2>

        <nav class="lang-switch" aria-label="Language selection">
          <a href="/" class="{% if lang != 'fr' %}active{% endif %}" title="English" lang="en">EN</a>
          <span class="separator" aria-hidden="true">|</span>
          <a href="/fr/" class="{% if lang == 'fr' %}active{% endif %}" title="Français" lang="fr">FR</a>
        </nav>
      </div>

      <nav aria-label="Main navigation">
        <ul class="nav-links">
          {% set t = i18n[lang or "en"] %}
          {% set isFr = (lang == "fr") %}

          <li><a href="{% if isFr %}/fr/{% else %}/{% endif %}" class="{% if page.url == '/' or page.url == '/fr/' %}active{% endif %}">{{ t.home }}</a></li>
          <li><a href="{% if isFr %}/fr/recherche/{% else %}/research/{% endif %}" class="{% if 'research' in page.url or 'recherche' in page.url %}active{% endif %}">{{ t.research }}</a></li>
          <li><a href="{% if isFr %}/fr/enseignement/{% else %}/teaching/{% endif %}" class="{% if 'teaching' in page.url or 'enseignement' in page.url %}active{% endif %}">{{ t.teaching }}</a></li>
          <li><a href="{% if isFr %}/fr/activites/{% else %}/activities/{% endif %}" class="{% if 'activities' in page.url or 'activites' in page.url %}active{% endif %}">{{ t.activities }}</a></li>
          <li><a href="{% if isFr %}/fr/contact/{% else %}/contact/{% endif %}" class="{% if 'contact' in page.url %}active{% endif %}">{{ t.contact }}</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main class="container">
    {{ content | safe }}
  </main>

  <footer>
    <div class="social-links">
      <a href="#" id="email-link" data-user="{{ site.email_user }}" data-domain="{{ site.email_domain }}" title="E-mail" aria-label="E-mail">
        <i class="fa-solid fa-envelope" aria-hidden="true"></i>
      </a>

      {% if site.orcid %}
      <a href="https://orcid.org/{{ site.orcid }}" target="_blank" rel="noopener" title="ORCID" aria-label="ORCID">
        <i class="fa-brands fa-orcid" aria-hidden="true"></i>
      </a>
      {% endif %}

      {% if site.arxiv %}
      <a href="{{ site.arxiv }}" target="_blank" rel="noopener" title="arXiv" aria-label="arXiv">
        <i class="fa-solid fa-graduation-cap" aria-hidden="true"></i>
      </a>
      {% endif %}

      {% if site.researchgate %}
      <a href="{{ site.researchgate }}" target="_blank" rel="noopener" title="ResearchGate" aria-label="ResearchGate">
        <i class="fa-brands fa-researchgate" aria-hidden="true"></i>
      </a>
      {% endif %}

      {% if site.linkedin %}
      <a href="{{ site.linkedin }}" target="_blank" rel="noopener" title="LinkedIn" aria-label="LinkedIn">
        <i class="fa-brands fa-linkedin" aria-hidden="true"></i>
      </a>
      {% endif %}
    </div>

    <div class="container">
      <p>&copy; 2026 Razvan Apredoaei — Site built with 11ty and the assistance of Google Gemini. Hosted on Netlify.</p>
    </div>
  </footer>

  <script>
  (function () {
    'use strict';

    /* --- 1. E-mail obscurci --------------------------------------------- */
    function initEmail() {
      var link = document.getElementById('email-link');
      if (!link) return;
      var user = link.dataset.user, domain = link.dataset.domain;
      if (!user || !domain) return;

      function reveal() {
        if (link.dataset.ready) return;
        link.href = 'mailto:' + user + '@' + domain;
        link.dataset.ready = '1';
      }
      link.addEventListener('pointerenter', reveal);
      link.addEventListener('touchstart', reveal, { passive: true });
      link.addEventListener('click', reveal);
    }

    /* --- 2. Navigation par balayage horizontal --------------------------- */
    function initSwipe() {
      var isFr = document.documentElement.lang === 'fr';
      var pages = isFr
        ? ['/fr/', '/fr/recherche/', '/fr/enseignement/', '/fr/activites/', '/fr/contact/']
        : ['/', '/research/', '/teaching/', '/activities/', '/contact/'];

      var path = location.pathname;
      if (path.charAt(path.length - 1) !== '/') path += '/';

      var index = pages.indexOf(path);
      if (index === -1) return;

      // Prefetch des pages adjacentes
      [pages[index - 1], pages[index + 1]].forEach(function (url) {
        if (!url) return;
        var l = document.createElement('link');
        l.rel = 'prefetch';
        l.href = url;
        document.head.appendChild(l);
      });

      var MIN_DISTANCE = 80;   // px
      var MAX_ANGLE = 30;      // degres autour de l'horizontale
      var startX = 0, startY = 0, locked = false;

      document.addEventListener('touchstart', function (e) {
        var t = e.changedTouches[0];
        startX = t.screenX;
        startY = t.screenY;
      }, { passive: true });

      document.addEventListener('touchend', function (e) {
        if (locked) return;
        var t = e.changedTouches[0];
        var dx = t.screenX - startX;
        var dy = t.screenY - startY;

        if (Math.sqrt(dx * dx + dy * dy) < MIN_DISTANCE) return;

        var angle = Math.abs(Math.atan2(dy, dx) * 180 / Math.PI);
        if (angle >= MAX_ANGLE && angle <= 180 - MAX_ANGLE) return; // scroll vertical

        var target = dx < 0 ? index + 1 : index - 1;
        if (target < 0 || target >= pages.length) return;

        locked = true;
        var main = document.querySelector('main');
        var links = document.querySelectorAll('.nav-links a');
        if (main) main.classList.add('fade-out');
        if (links[index]) links[index].classList.remove('active');
        if (links[target]) links[target].classList.add('active');

        setTimeout(function () { location.href = pages[target]; }, 200);
      }, { passive: true });
    }

    /* --- 3. Netlify Identity -------------------------------------------- */
    function initNetlify() {
      if (!window.netlifyIdentity) return;
      window.netlifyIdentity.on('init', function (user) {
        if (user) return;
        window.netlifyIdentity.on('login', function () {
          location.href = '/admin/';
        });
      });
    }

    function init() { initEmail(); initSwipe(); initNetlify(); }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init, { once: true });
    } else {
      init();
    }
  })();
  </script>
</body>
</html>