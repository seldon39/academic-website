<!DOCTYPE html>
<html lang="{{ lang or 'en' }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="google-site-verification" content="zynSqpGiXhh0hxyMgPxqkuckaRrMupw3AnHVsFhe1oA" />
  
  <meta name="theme-color" content="#ffffff" />

  <title>{% if title %}{{ title }} | {% endif %}Razvan Apredoaei</title>
  <meta name="description" content="{{ description or site.description or 'Page personnelle et travaux de recherche de Razvan Apredoaei, chercheur en mathématiques.' }}">
  <meta name="author" content="Razvan Apredoaei">
  <meta name="robots" content="index, follow">

  {% if site.url %}
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {% endif %}

  <meta property="og:type" content="website">
  <meta property="og:title" content="{% if title %}{{ title }} | {% endif %}Razvan Apredoaei">
  <meta property="og:description" content="{{ description or site.description or 'Page personnelle et travaux de recherche de Razvan Apredoaei.' }}">
  {% if site.url %}
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  {% endif %}
  <meta property="og:site_name" content="Razvan Apredoaei">

  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{% if title %}{{ title }} | {% endif %}Razvan Apredoaei">
  <meta name="twitter:description" content="{{ description or site.description or 'Page personnelle et travaux de recherche de Razvan Apredoaei.' }}">

  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
  <link rel="stylesheet" href="/assets/style.css">

  <link rel="preload" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></noscript>
  
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js" defer></script>

  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
  <link rel="shortcut icon" href="/assets/favicon.ico" />
  <link rel="icon" type="image/x-icon" href="/assets/favicon.ico" />
  <link rel="icon" type="image/png" sizes="96x96" href="/assets/favicon-96x96.png" />
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <meta name="apple-mobile-web-app-title" content="Razvan Apredoaei" />
  <link rel="manifest" href="/assets/site.webmanifest" />

  <style>
    /* Empêche le rebond natif problématique du navigateur pour le remplacer par notre animation personnalisée */
    html, body {
      overscroll-behavior-y: none;
    }

    /* Transition fluide pour le retour en place de l'effet ressort */
    main.container {
      will-change: transform;
    }
    
    main.bounce-restore {
      transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
    }
  </style>
</head>

<body>
  <header>
    <div class="container header-content">
      <div class="header-top">
        <h2 class="site-header-title">
          <a href="{% if lang == 'fr' %}/fr/{% else %}/{% endif %}" class="site-title">
            <img src="/assets/favicon.svg" alt="" class="site-logo" width="28" height="28" />
            <span>Razvan Apredoaei</span>
          </a>
        </h2>

        <div class="lang-switch">
          <a href="/" class="{% if lang != 'fr' %}active{% endif %}" title="English">EN</a>
          <span class="separator">|</span>
          <a href="/fr/" class="{% if lang == 'fr' %}active{% endif %}" title="Français">FR</a>
        </div>
      </div>

      <nav>
        <ul class="nav-links">
          {% set t = i18n[lang or "en"] %}
          {% set isFr = (lang == "fr") %}
          
          <li><a href="{% if isFr %}/fr/{% else %}/{% endif %}" class="{% if page.url == '/' or page.url == '/fr/' %}active{% endif %}">{{ t.home }}</a></li>
          <li><a href="{% if isFr %}/fr/recherche/{% else %}/research/{% endif %}" class="{% if 'research' in page.url or 'recherche' in page.url %}active{% endif %}">{{ t.research }}</a></li>
          <li><a href="{% if isFr %}/fr/enseignement/{% else %}/teaching/{% endif %}" class="{% if 'teaching' in page.url or 'enseignement' in page.url %}active{% endif %}">{{ t.teaching }}</a></li>
          <li><a href="{% if isFr %}/fr/activites/{% else %}/activities/{% endif %}" class="{% if 'activities' in page.url or 'activites' in page.url %}active{% endif %}">{{ t.activities }}</a></li>
          <li><a href="{% if isFr %}/fr/contact/{% else %}/contact/{% endif %}" class="{% if 'contact' in page.url %}active{% endif %}">{{ t.contact }}</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main class="container">
    {{ content | safe }}
  </main>

  <footer>
    <div class="social-links">
      <a href="#" 
         id="email-link" 
         data-user="{{ site.email_user }}" 
         data-domain="{{ site.email_domain }}" 
         title="E-mail" 
         aria-label="E-mail">
        <i class="fa-regular fa-envelope"></i>
      </a>

      {% if site.orcid %}
      <a href="https://orcid.org/{{ site.orcid }}" target="_blank" rel="noopener" title="ORCID" aria-label="ORCID">
        <i class="fa-brands fa-orcid"></i>
      </a>
      {% endif %}

      {% if site.arxiv %}
      <a href="{{ site.arxiv }}" target="_blank" rel="noopener" title="arXiv" aria-label="arXiv">
        <i class="fa-solid fa-graduation-cap"></i>
      </a>
      {% endif %}

      {% if site.researchgate %}
      <a href="{{ site.researchgate }}" target="_blank" rel="noopener" title="ResearchGate" aria-label="ResearchGate">
        <i class="fa-brands fa-researchgate"></i>
      </a>
      {% endif %}

      {% if site.linkedin %}
      <a href="{{ site.linkedin }}" target="_blank" rel="noopener" title="LinkedIn" aria-label="LinkedIn">
        <i class="fa-brands fa-linkedin"></i>
      </a>
      {% endif %}
    </div>

    <div class="container">
      <p>&copy; 2026 Razvan Apredoaei — Site built with 11ty and the assistance of Google Gemini. Hosted on Netlify.</p>
    </div>
  </footer>

  <script>
    document.addEventListener("DOMContentLoaded", function() {
      const emailLink = document.getElementById("email-link");
      if (emailLink) {
        const user = emailLink.getAttribute("data-user");
        const domain = emailLink.getAttribute("data-domain");
        if (user && domain) {
          const fullEmail = user + "@" + domain;
          const setEmailHref = () => { emailLink.href = "mailto:" + fullEmail; };

          emailLink.addEventListener("mouseenter", setEmailHref);
          emailLink.addEventListener("touchstart", setEmailHref, { passive: true });
          emailLink.addEventListener("click", setEmailHref);
        }
      }
    });
  </script>

  <!-- Script combiné : Navigation Swipe Horizontal + Effet Ressort (Overscroll Elastic) -->
  <script>
    (function() {
      const isFr = document.documentElement.lang === 'fr';
      const menuPages = isFr 
        ? ['/fr/', '/fr/recherche/', '/fr/enseignement/', '/fr/activites/', '/fr/contact/']
        : ['/', '/research/', '/teaching/', '/activities/', '/contact/'];

      let currentPath = window.location.pathname;
      if (!currentPath.endsWith('/')) currentPath += '/';
      
      let currentIndex = menuPages.findIndex(page => {
        let p = page.endsWith('/') ? page : page + '/';
        return p === currentPath;
      });

      // Prefetch des pages adjacentes
      if (currentIndex !== -1) {
        function prefetchPage(url) {
          if (!document.querySelector(`link[href="${url}"]`)) {
            const link = document.createElement('link');
            link.rel = 'prefetch';
            link.href = url;
            document.head.appendChild(link);
          }
        }
        if (currentIndex > 0) prefetchPage(menuPages[currentIndex - 1]);
        if (currentIndex < menuPages.length - 1) prefetchPage(menuPages[currentIndex + 1]);
      }

      const mainContainer = document.querySelector('main.container');

      let startX = 0;
      let startY = 0;
      let isHorizontalSwipe = false;
      let isVerticalBounce = false;
      let isAtBottom = false;

      document.addEventListener('touchstart', function(e) {
        if (e.touches.length > 1) return;
        
        startX = e.touches[0].clientX;
        startY = e.touches[0].clientY;
        isHorizontalSwipe = false;
        isVerticalBounce = false;

        if (mainContainer) {
          mainContainer.classList.remove('bounce-restore');
        }

        // Vérification si l'utilisateur est au bas de la page
        const scrollTop = window.scrollY || document.documentElement.scrollTop;
        const scrollHeight = document.documentElement.scrollHeight;
        const clientHeight = document.documentElement.clientHeight;
        
        isAtBottom = (scrollTop + clientHeight >= scrollHeight - 5);
      }, { passive: true });

      document.addEventListener('touchmove', function(e) {
        const currentX = e.touches[0].clientX;
        const currentY = e.touches[0].clientY;
        const diffX = currentX - startX;
        const diffY = currentY - startY;

        // Détection du type de mouvement
        if (!isHorizontalSwipe && !isVerticalBounce) {
          if (Math.abs(diffX) > 10 || Math.abs(diffY) > 10) {
            if (Math.abs(diffX) > Math.abs(diffY) * 1.2) {
              isHorizontalSwipe = true; // Swipe horizontal pour naviguer
            } else {
              isVerticalBounce = true; // Défilement / Rebond vertical
            }
          }
        }

        // Effet Ressort (Overscroll Elastic) en bas de page
        if (isVerticalBounce && isAtBottom && diffY < 0 && mainContainer) {
          // Résistance physique progressive (effet élastique)
          const pullDistance = Math.abs(diffY);
          const bounceOffset = -Math.pow(pullDistance, 0.75); 
          mainContainer.style.transform = `translateY(${bounceOffset}px)`;
        }
      }, { passive: true });

      document.addEventListener('touchend', function(e) {
        // 1. Remise en place fluide de l'effet ressort vertical
        if (mainContainer && mainContainer.style.transform !== '') {
          mainContainer.classList.add('bounce-restore');
          mainContainer.style.transform = 'translateY(0px)';
          setTimeout(() => {
            if (mainContainer.style.transform === 'translateY(0px)') {
              mainContainer.style.transform = '';
            }
          }, 400);
        }

        // 2. Traitement du swipe horizontal (changement de rubrique)
        if (isHorizontalSwipe && currentIndex !== -1) {
          const endX = e.changedTouches[0].clientX;
          const diffX = endX - startX;

          if (Math.abs(diffX) > 50) {
            if (diffX < 0 && currentIndex < menuPages.length - 1) {
              window.location.href = menuPages[currentIndex + 1];
            } else if (diffX > 0 && currentIndex > 0) {
              window.location.href = menuPages[currentIndex - 1];
            }
          }
        }
      }, { passive: true });
    })();
  </script>

  <script>
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on("init", user => {
        if (!user) {
          window.netlifyIdentity.on("login", () => {
            document.location.href = "/admin/";
          });
        }
      });
    }
  </script>
</body>
</html>