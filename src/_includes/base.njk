{%- set isFr = (lang == "fr") -%}
{%- set t = i18n[lang or "en"] -%}
{%- set enUrl = "/" -%}{%- set frUrl = "/fr/" -%}
{%- if "research" in page.url or "recherche" in page.url -%}
  {%- set enUrl = "/research/" -%}{%- set frUrl = "/fr/recherche/" -%}
{%- elif "teaching" in page.url or "enseignement" in page.url -%}
  {%- set enUrl = "/teaching/" -%}{%- set frUrl = "/fr/enseignement/" -%}
{%- elif "activities" in page.url or "activites" in page.url -%}
  {%- set enUrl = "/activities/" -%}{%- set frUrl = "/fr/activites/" -%}
{%- elif "contact" in page.url -%}
  {%- set enUrl = "/contact/" -%}{%- set frUrl = "/fr/contact/" -%}
{%- endif -%}
<!DOCTYPE html>
<html lang="{{ lang or 'en' }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="google-site-verification" content="zynSqpGiXhh0hxyMgPxqkuckaRrMupw3AnHVsFhe1oA" />
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#1e293b" media="(prefers-color-scheme: dark)" />

  <title>{% if title %}{{ title }} | {% endif %}Razvan Apredoaei</title>
  <meta name="description" content="{{ description or site.description or 'Page personnelle et travaux de recherche de Razvan Apredoaei, chercheur en mathématiques.' }}">
  <meta name="author" content="Razvan Apredoaei">
  <meta name="robots" content="index, follow">

  {% if site.url %}
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    <link rel="alternate" hreflang="en" href="{{ site.url }}{{ enUrl }}">
    <link rel="alternate" hreflang="fr" href="{{ site.url }}{{ frUrl }}">
    <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ enUrl }}">
  {% endif %}

  <meta property="og:type" content="website">
  <meta property="og:title" content="{% if title %}{{ title }} | {% endif %}Razvan Apredoaei">
  <meta property="og:description" content="{{ description or site.description or 'Page personnelle et travaux de recherche de Razvan Apredoaei.' }}">
  {% if site.url %}
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  {% endif %}
  <meta property="og:site_name" content="Razvan Apredoaei">

  {% if site.url %}
    <meta property="og:image" content="{{ site.url }}/assets/ogimage.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Razvan Apredoaei">
    <meta name="twitter:image" content="{{ site.url }}/assets/ogimage.png">
  {% endif %}

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{% if title %}{{ title }} | {% endif %}Razvan Apredoaei">
  <meta name="twitter:description" content="{{ description or site.description or 'Page personnelle et travaux de recherche de Razvan Apredoaei.' }}">

  <!-- CSS principal (bloquant : evite le FOUC). Seule ressource externe
       de la page : plus aucun CDN tiers, plus aucune police a telecharger. -->
  <link rel="stylesheet" href="/assets/style.css">

  {#- KaTeX : la feuille n'est chargee que sur les pages contenant reellement
      une formule, donc les autres ne paient rien. Le "+ """ force la conversion
      en chaine : selon la version d'Eleventy, content peut etre un objet
      SafeString, sur lequel la recherche echouerait sans lever d'erreur.
      Ajouter "math: true" au front-matter force le chargement si besoin. -#}
  {% if math or "katex" in (content + "") %}
  <link rel="stylesheet" href="/assets/katex/katex.min.css">
  {% endif %}
  <link rel="shortcut icon" href="/assets/favicon.ico?v=2" />
  <link rel="icon" type="image/x-icon" href="/assets/favicon.ico?v=2" />
  <link rel="icon" type="image/png" sizes="96x96" href="/assets/favicon-96x96.png?v=2" />
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg?v=2" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png?v=2" />
  <meta name="apple-mobile-web-app-title" content="Razvan Apredoaei" />
  <link rel="manifest" href="/assets/site.webmanifest" />

  {%- set profils = [] -%}
  {%- if site.orcid %}{% set profils = profils.concat(["https://orcid.org/" + site.orcid]) %}{% endif -%}
  {%- if site.arxiv %}{% set profils = profils.concat([site.arxiv]) %}{% endif -%}
  {%- if site.researchgate %}{% set profils = profils.concat([site.researchgate]) %}{% endif -%}
  {%- if site.linkedin %}{% set profils = profils.concat([site.linkedin]) %}{% endif -%}
  {% if site.url %}
  <!-- Donnees structurees : indique aux moteurs que cette page et les profils
       listes en sameAs designent une seule et meme personne. -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Razvan Apredoaei",
    "url": {{ site.url | dump | safe }},
    "image": {{ (site.url + "/assets/photo.webp") | dump | safe }},
    "sameAs": {{ profils | dump | safe }}
  }
  </script>
  {% endif %}
</head>

<body>
  <a class="skip-link" href="#contenu">{% if isFr %}Aller au contenu{% else %}Skip to content{% endif %}</a>

  <header>
    <div class="container header-content">
      <div class="header-top">
        <!-- h1 et non h2 : chaque page doit porter exactement un titre de
             niveau 1. La mise en forme vient de la classe, donc rien ne bouge. -->
        <h1 class="site-header-title">
          <a href="{% if lang == 'fr' %}/fr/{% else %}/{% endif %}" class="site-title">
            <!-- Logo vectoriel inline, une seule couche.
                 width/height/fill sont des attributs : le logo reste correct
                 meme si le CSS est absent, ancien ou en cache.
                 Classe "site-mark" (et non "site-logo") pour qu'aucune ancienne
                 regle .site-logo ne puisse s'y appliquer. -->
            <svg class="site-mark" width="26" height="25" viewBox="7.06 8.5 85.89 83"
                 fill="currentColor" aria-hidden="true" focusable="false"
                 xmlns="http://www.w3.org/2000/svg">
              <path d="M81.18 32A36 36 0 1 1 56.25 14.55" fill="none" stroke="currentColor" stroke-width="11" stroke-linecap="round"/><circle cx="50" cy="50" r="13"/>
            </svg><!-- pas d espace ici : en contexte inline, un saut de ligne
                 produirait une espace typographique qui s ajouterait a la marge
            --><span>Razvan Apredoaei</span>
          </a>
        </h1>

        <nav class="lang-switch" aria-label="Language selection">
          <a href="{{ enUrl }}" hreflang="en" class="{% if not isFr %}active{% endif %}" title="English" lang="en">EN</a>
          <span class="separator" aria-hidden="true">|</span>
          <a href="{{ frUrl }}" hreflang="fr" class="{% if isFr %}active{% endif %}" title="Français" lang="fr">FR</a>
        </nav>
      </div>

      <nav aria-label="Main navigation">
        <ul class="nav-links">
          <li><a href="{% if isFr %}/fr/{% else %}/{% endif %}" class="{% if page.url == '/' or page.url == '/fr/' %}active{% endif %}">{{ t.home }}</a></li>
          <li><a href="{% if isFr %}/fr/recherche/{% else %}/research/{% endif %}" class="{% if 'research' in page.url or 'recherche' in page.url %}active{% endif %}">{{ t.research }}</a></li>
          <li><a href="{% if isFr %}/fr/enseignement/{% else %}/teaching/{% endif %}" class="{% if 'teaching' in page.url or 'enseignement' in page.url %}active{% endif %}">{{ t.teaching }}</a></li>
          <li><a href="{% if isFr %}/fr/activites/{% else %}/activities/{% endif %}" class="{% if 'activities' in page.url or 'activites' in page.url %}active{% endif %}">{{ t.activities }}</a></li>
          <li><a href="{% if isFr %}/fr/contact/{% else %}/contact/{% endif %}" class="{% if 'contact' in page.url %}active{% endif %}">{{ t.contact }}</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main class="container" id="contenu" tabindex="-1">
    {{ content | safe }}
  </main>

  <footer>
    <!-- Icones : Font Awesome Free 6.5.1, CC BY 4.0 (fontawesome.com/license/free),
         tracés inlines pour supprimer la feuille CSS et les polices distantes. -->
    <div class="social-links">
      <a href="#" id="email-link" data-user="{{ site.email_user }}" data-domain="{{ site.email_domain }}" title="E-mail" aria-label="E-mail"><svg class="ico-mail" viewBox="0 0 512 512" aria-hidden="true" focusable="false"><path d="M48 64C21.5 64 0 85.5 0 112c0 15.1 7.1 29.3 19.2 38.4L236.8 313.6c11.4 8.5 27 8.5 38.4 0L492.8 150.4c12.1-9.1 19.2-23.3 19.2-38.4c0-26.5-21.5-48-48-48H48zM0 176V384c0 35.3 28.7 64 64 64H448c35.3 0 64-28.7 64-64V176L294.4 339.2c-22.8 17.1-54 17.1-76.8 0L0 176z"/></svg></a>

      {% if site.orcid %}
      <a href="https://orcid.org/{{ site.orcid }}" target="_blank" rel="noopener" title="ORCID" aria-label="ORCID"><svg class="ico-orcid" viewBox="0 0 512 512" aria-hidden="true" focusable="false"><path d="M294.75 188.19h-45.92V342h47.47c67.62 0 83.12-51.34 83.12-76.91 0-41.64-26.54-76.9-84.67-76.9zM256 8C119 8 8 119 8 256s111 248 248 248 248-111 248-248S393 8 256 8zm-80.79 360.76h-29.84v-207.5h29.84zm-14.92-231.14a19.57 19.57 0 1 1 19.57-19.57 19.64 19.64 0 0 1-19.57 19.57zM300 369h-81V161.26h80.6c76.73 0 110.44 54.83 110.44 103.85C410 318.39 368.38 369 300 369z"/></svg></a>
      {% endif %}

      {% if site.arxiv %}
      <a href="{{ site.arxiv }}" target="_blank" rel="noopener" title="arXiv" aria-label="arXiv"><svg class="ico-cap" viewBox="0 0 640 512" aria-hidden="true" focusable="false"><path d="M320 32c-8.1 0-16.1 1.4-23.7 4.1L15.8 137.4C6.3 140.9 0 149.9 0 160s6.3 19.1 15.8 22.6l57.9 20.9C57.3 229.3 48 259.8 48 291.9v28.1c0 28.4-10.8 57.7-22.3 80.8c-6.5 13-13.9 25.8-22.5 37.6C0 442.7-.9 448.3 .9 453.4s6 8.9 11.2 10.2l64 16c4.2 1.1 8.7 .3 12.4-2s6.3-6.1 7.1-10.4c8.6-42.8 4.3-81.2-2.1-108.7C90.3 344.3 86 329.8 80 316.5V291.9c0-30.2 10.2-58.7 27.9-81.5c12.9-15.5 29.6-28 49.2-35.7l157-61.7c8.2-3.2 17.5 .8 20.7 9s-.8 17.5-9 20.7l-157 61.7c-12.4 4.9-23.3 12.4-32.2 21.6l159.6 57.6c7.6 2.7 15.6 4.1 23.7 4.1s16.1-1.4 23.7-4.1L624.2 182.6c9.5-3.4 15.8-12.5 15.8-22.6s-6.3-19.1-15.8-22.6L343.7 36.1C336.1 33.4 328.1 32 320 32zM128 408c0 35.3 86 72 192 72s192-36.7 192-72L496.7 262.6 354.5 314c-11.1 4-22.8 6-34.5 6s-23.5-2-34.5-6L143.3 262.6 128 408z"/></svg></a>
      {% endif %}

      {% if site.researchgate %}
      <a href="{{ site.researchgate }}" target="_blank" rel="noopener" title="ResearchGate" aria-label="ResearchGate"><svg class="ico-rg" viewBox="0 0 448 512" aria-hidden="true" focusable="false"><path d="M0 32v448h448V32H0zm262.2 334.4c-6.6 3-33.2 6-50-14.2-9.2-10.6-25.3-33.3-42.2-63.6-8.9 0-14.7 0-21.4-.6v46.4c0 23.5 6 21.2 25.8 23.9v8.1c-6.9-.3-23.1-.8-35.6-.8-13.1 0-26.1.6-33.6.8v-8.1c15.5-2.9 22-1.3 22-23.9V225c0-22.6-6.4-21-22-23.9V193c25.8 1 53.1-.6 70.9-.6 31.7 0 55.9 14.4 55.9 45.6 0 21.1-16.7 42.2-39.2 47.5 13.6 24.2 30 45.6 42.2 58.9 7.2 7.8 17.2 14.7 27.2 14.7v7.3zm22.9-135c-23.3 0-32.2-15.7-32.2-32.2V167c0-12.2 8.8-30.4 34-30.4s30.4 17.9 30.4 17.9l-10.7 7.2s-5.5-12.5-19.7-12.5c-7.9 0-19.7 7.3-19.7 19.7v26.8c0 13.4 6.6 23.3 17.9 23.3 14.1 0 21.5-10.9 21.5-26.8h-17.9v-10.7h30.4c0 20.5 4.7 49.9-34 49.9zm-116.5 44.7c-9.4 0-13.6-.3-20-.8v-69.7c6.4-.6 15-.6 22.5-.6 23.3 0 37.2 12.2 37.2 34.5 0 21.9-15 36.6-39.7 36.6z"/></svg></a>
      {% endif %}

      {% if site.linkedin %}
      <a href="{{ site.linkedin }}" target="_blank" rel="noopener" title="LinkedIn" aria-label="LinkedIn"><svg class="ico-in" viewBox="0 0 448 512" aria-hidden="true" focusable="false"><path d="M416 32H31.9C14.3 32 0 46.5 0 64.3v383.4C0 465.5 14.3 480 31.9 480H416c17.6 0 32-14.5 32-32.3V64.3c0-17.8-14.4-32.3-32-32.3zM135.4 416H69V202.2h66.5V416zm-33.2-243c-21.3 0-38.5-17.3-38.5-38.5S80.9 96 102.2 96c21.2 0 38.5 17.3 38.5 38.5 0 21.3-17.2 38.5-38.5 38.5zm282.1 243h-66.4V312c0-24.8-.5-56.7-34.5-56.7-34.6 0-39.9 27-39.9 54.9V416h-66.4V202.2h63.7v29.2h.9c8.9-16.8 30.6-34.5 62.9-34.5 67.2 0 79.7 44.3 79.7 101.9V416z"/></svg></a>
      {% endif %}
    </div>

    <div class="container">
      <p>&copy; 2026 Razvan Apredoaei — Built with 11ty with AI assistance (Gemini & Claude Opus). Hosted on Netlify.</p>
    </div>
  </footer>

  <script>
  (function () {
    'use strict';

    /* --- 1. E-mail obscurci --------------------------------------------- */
    function initEmail() {
      var link = document.getElementById('email-link');
      if (!link) return;
      var user = link.dataset.user, domain = link.dataset.domain;
      if (!user || !domain) return;

      function reveal() {
        if (link.dataset.ready) return;
        link.href = 'mailto:' + user + '@' + domain;
        link.dataset.ready = '1';
      }
      link.addEventListener('pointerenter', reveal);
      link.addEventListener('touchstart', reveal, { passive: true });
      link.addEventListener('click', reveal);
    }

    /* --- 2. Navigation entre pages (balayage + clavier) ------------------ */
    function initSwipe() {
      var isFr = document.documentElement.lang === 'fr';
      var pages = isFr
        ? ['/fr/', '/fr/recherche/', '/fr/enseignement/', '/fr/activites/', '/fr/contact/']
        : ['/', '/research/', '/teaching/', '/activities/', '/contact/'];

      var path = location.pathname;
      if (path.charAt(path.length - 1) !== '/') path += '/';

      var index = pages.indexOf(path);
      if (index === -1) return;

      // Prefetch de TOUTES les autres pages du menu, pas seulement des voisines :
      // elles pesent quelques Ko chacune, donc n'importe quel item du menu
      // repond ensuite instantanement.
      pages.forEach(function (url, i) {
        if (i === index) return;
        var l = document.createElement('link');
        l.rel = 'prefetch';
        l.href = url;
        document.head.appendChild(l);
      });

      var locked = false;

      function goTo(target) {
        if (locked || target < 0 || target >= pages.length) return;
        locked = true;

        var links = document.querySelectorAll('.nav-links a');
        if (links[index]) links[index].classList.remove('active');
        if (links[target]) links[target].classList.add('active');

        // On laisse TOUJOURS jouer le retour visuel avant de naviguer : la barre
        // du menu glisse de l'onglet quitte vers l'onglet vise (0.2s) pendant
        // que le contenu s'estompe. Naviguer immediatement, meme avec une
        // transition de vue, coupe cette animation avant qu'elle ne commence.
        var main = document.querySelector('main');
        if (main) main.classList.add('fade-out');
        setTimeout(function () { location.href = pages[target]; }, 220);
      }

      /* Balayage horizontal */
      var MIN_DISTANCE = 80;   // px
      var MAX_ANGLE = 30;      // degres autour de l'horizontale
      var startX = 0, startY = 0;

      document.addEventListener('touchstart', function (e) {
        var t = e.changedTouches[0];
        startX = t.screenX;
        startY = t.screenY;
      }, { passive: true });

      document.addEventListener('touchend', function (e) {
        var t = e.changedTouches[0];
        var dx = t.screenX - startX;
        var dy = t.screenY - startY;

        if (Math.sqrt(dx * dx + dy * dy) < MIN_DISTANCE) return;

        var angle = Math.abs(Math.atan2(dy, dx) * 180 / Math.PI);
        if (angle >= MAX_ANGLE && angle <= 180 - MAX_ANGLE) return; // scroll vertical

        goTo(dx < 0 ? index + 1 : index - 1);
      }, { passive: true });

      /* Fleches gauche / droite : equivalent clavier du balayage */
      document.addEventListener('keydown', function (e) {
        if (e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
        var el = e.target;
        if (el && (el.isContentEditable ||
            /^(INPUT|TEXTAREA|SELECT|BUTTON)$/.test(el.tagName))) return;
        if (e.key === 'ArrowRight') goTo(index + 1);
        else if (e.key === 'ArrowLeft') goTo(index - 1);
      });
    }

    /* --- 3. Netlify Identity -------------------------------------------- */
    // ~200 Ko de JS tiers qui ne servent qu'a la connexion au CMS. On ne les
    // charge donc que sur /admin/ ou quand Netlify renvoie un jeton dans l'URL
    // (invitation, recuperation, confirmation). Les autres pages n'y touchent pas.
    function initNetlify() {
      var needed = /^\/admin\/?/.test(location.pathname) ||
        /(invite_token|recovery_token|confirmation_token|email_change_token)=/.test(location.hash);
      if (!needed) return;

      var s = document.createElement('script');
      s.src = 'https://identity.netlify.com/v1/netlify-identity-widget.js';
      s.onload = function () {
        if (!window.netlifyIdentity) return;
        window.netlifyIdentity.on('init', function (user) {
          if (user) return;
          window.netlifyIdentity.on('login', function () { location.href = '/admin/'; });
        });
      };
      document.head.appendChild(s);
    }

    /* --- 4. Retour tactile ---------------------------------------------- */
    // iOS n'applique :active au toucher que si la page ecoute un evenement
    // touch. Cet ecouteur vide suffit a debloquer l'etat actif sur les liens.
    function initActiveState() {
      document.addEventListener('touchstart', function () {}, { passive: true });
    }

    function init() { initEmail(); initSwipe(); initNetlify(); initActiveState(); }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init, { once: true });
    } else {
      init();
    }
  })();
  </script>
</body>
</html>