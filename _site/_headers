# A placer a la racine du dossier publie (a cote de _redirects).
#
# Note : ceci n'influence pas la note de performance PageSpeed, qui ne mesure
# que la premiere visite. Cela ameliore les visites suivantes et fait taire
# le diagnostic « Serve static assets with an efficient cache policy ».

/assets/*
  Cache-Control: public, max-age=86400

# Les images et le PDF ne changent quasiment jamais : cache long.
/assets/photo.webp
  Cache-Control: public, max-age=31536000, immutable

/assets/favicon.svg
  Cache-Control: public, max-age=31536000, immutable

/assets/cv_apredoaei.pdf
  Cache-Control: public, max-age=604800

# Securite : n'affecte pas la note de performance, mais compte dans
# « Bonnes pratiques » de PageSpeed.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin