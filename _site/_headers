# A placer dans src/ — votre configuration le recopie a la racine du site
# publie via addPassthroughCopy("src/_headers").
#
# Note : ceci n'influence pas la note de performance PageSpeed, qui ne mesure
# que la premiere visite. Cela ameliore les visites suivantes et fait taire
# le diagnostic « Serve static assets with an efficient cache policy ».

/assets/*
  Cache-Control: public, max-age=86400

# Cache long reserve aux fichiers dont le NOM change quand le contenu change.
# `immutable` dit au navigateur de ne jamais revalider : sur un nom stable comme
# photo.webp, il enferme les visiteurs sur l'ancienne version pendant un an, sans
# qu'aucun rechargement force n'y puisse rien. La photo et le CV sont donc alignes
# sur une semaine, et sans `immutable` : une mise a jour se propage d'elle-meme.

/assets/photo.webp
  Cache-Control: public, max-age=604800

/assets/favicon.svg
  Cache-Control: public, max-age=31536000, immutable

/assets/cv_apredoaei.pdf
  Cache-Control: public, max-age=604800

# KaTeX : feuille de style et polices issues du paquet npm, donc figees pour
# une version donnee. Cache maximal.

/assets/katex/*
  Cache-Control: public, max-age=31536000, immutable

# Securite : n'affecte pas la note de performance, mais compte dans
# « Bonnes pratiques » de PageSpeed.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin